# Copy to .env for local development. Every value is optional locally.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave empty locally to use SQLite. Production: Supabase pooler URL for the correct region.
DATABASE_URL=

# Leave empty locally to print emails in the terminal.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=NexSpace <no-reply@example.com>

# Leave empty locally to store uploads in /media.
CLOUDINARY_URL=

# Public base URL used in emails (verification + password reset links).
SITE_URL=http://127.0.0.1:8000

# Browser push (optional). Generate with: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# NexAI (optional). Without a key NexAI shows matching passages from course materials only.
ANTHROPIC_API_KEY=
NEXAI_MODEL=claude-haiku-4-5-20251001
NEXAI_DAILY_LIMIT=40
